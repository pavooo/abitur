{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abiturklausuren-archiv.local/schema/klausur.schema.json",
  "title": "Klausur",
  "type": "object",
  "required": ["id", "fach", "jahr", "kursart", "termin", "titel", "hilfsmittel", "aufgaben"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Paket-interne ID, referenziert die Dateien in dateien/<id>.pdf bzw. <id>-ewh.pdf."
    },
    "fach": { "type": "string", "minLength": 1, "maxLength": 10 },
    "jahr": { "type": "integer", "minimum": 2000, "maximum": 2100 },
    "kursart": { "type": "string", "enum": ["GK", "LK"] },
    "termin": {
      "type": "string",
      "enum": ["haupttermin", "nachschreibtermin"],
      "description": "Pflichtfeld. Im Zweifel nie 'haupttermin' setzen."
    },
    "variante": { "type": "string", "default": "" },
    "titel": { "type": "string", "minLength": 1 },
    "hilfsmittel": { "type": "string", "enum": ["TR", "CAS"] },
    "aufgaben": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/aufgabe" }
    }
  },
  "$defs": {
    "aufgabe": {
      "type": "object",
      "required": ["nummer", "seiten", "pruefungsteil", "teilaufgaben"],
      "additionalProperties": false,
      "properties": {
        "nummer": { "type": "integer", "minimum": 1 },
        "kontext": { "type": "string", "default": "" },
        "seiten": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2,
          "description": "[erste Seite, letzte Seite] der Aufgabe."
        },
        "pruefungsteil": { "type": "string", "enum": ["hilfsmittelfrei", "mit_hilfsmitteln"] },
        "aufgabenbereich": {
          "type": "string",
          "enum": ["pflicht", "wahlpflicht", "keine_angabe"],
          "default": "keine_angabe",
          "description": "Fehlt bei älteren Klausuren ohne diese Einteilung; dann 'keine_angabe'."
        },
        "teilaufgaben": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/teilaufgabe" }
        }
      }
    },
    "teilaufgabe": {
      "type": "object",
      "required": ["bezeichnung", "seite", "text", "anforderungsbereich"],
      "additionalProperties": false,
      "properties": {
        "bezeichnung": { "type": "string", "minLength": 1 },
        "seite": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 },
        "punkte": { "type": "integer", "minimum": 0 },
        "themen": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$" },
          "default": []
        },
        "anforderungsbereich": { "type": "string", "enum": ["I", "II", "III"] },
        "operatoren": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "begruendung": { "type": "string", "default": "" }
      }
    }
  }
}
