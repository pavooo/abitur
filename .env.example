# Kopieren nach .env und Werte anpassen. .env wird nie committet.

DJANGO_SECRET_KEY=bitte-durch-zufälligen-wert-ersetzen
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Hostname "db" passt zum docker-compose-Service. Für lokales manage.py ohne
# Docker ggf. auf "localhost" ändern (Postgres-Port ist auch auf dem Host offen).
DATABASE_URL=postgres://abitur:abitur@db:5432/abitur

# Werden vom db-Service in docker-compose.yml verwendet und müssen zu DATABASE_URL passen.
POSTGRES_DB=abitur
POSTGRES_USER=abitur
POSTGRES_PASSWORD=abitur

# Nicht erratbarer Pfad zum (verborgenen) Django-Admin, z. B. per `openssl rand -hex 16`.
DJANGO_ADMIN_PFAD=django-admin-bitte-aendern/
